DATABASE_URL="postgresql://paylane:paylane@localhost:5432/paylane?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Secret used to sign webhooks sent to merchants (HMAC-SHA256). Per-merchant secrets live in the DB.
WEBHOOK_SIGNING_FALLBACK_SECRET="change-me"

# Mock bank behaviour (used by the failure-injection service)
MOCK_BANK_APPROVE_RATE=0.8
MOCK_BANK_DECLINE_RATE=0.1
MOCK_BANK_TIMEOUT_RATE=0.1
